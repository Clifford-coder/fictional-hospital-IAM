# Part 2 version pins and local decisions: one place to read them, one place to change them.
# Plain KEY=VALUE, one per line, with NO trailing comments (comments go on their own line above).
# Anything after the value would become part of the value in some tools, so keep it that way.
# bash can `source` this file and scripts/preflight.sh compares it with what is installed.
# Dockerfiles and manifests still carry their own exact tags; when you change one here,
# change it there in the same commit.

# --- Identity server ---------------------------------------------------------------
# Upgraded on purpose in Phase 5.
KEYCLOAK_VERSION=26.7.4
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.4@sha256:82a77884f3af238beab1e7afd63b5f530e1b5c0590bd7aa60b40a40463e29b2c

# --- Cluster ---------------------------------------------------------------------------
# Check the kind releases page for anything newer.
KIND_VERSION=v0.33.0
# Kubernetes 1.36, not 1.37: cert-manager 1.21 is documented for Kubernetes 1.33-1.36.
K8S_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
# CNI that actually enforces NetworkPolicy.
CALICO_VERSION=v3.33.0
# Local certificate authority.
CERT_MANAGER_VERSION=v1.21.3

# --- Images (digests recorded from `docker pull` on 2026-11-25; the digest is what Docker actually pins) ---
POSTGRES_IMAGE=postgres:17.12@sha256:87c8b42f423b45d5247e6aa8fdb2e7762fec164c68a50fe3eb07e7bfcaf4dbcf
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30.6-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03
PYTHON_IMAGE=python:3.13.18-slim@sha256:7249d5587b78209a006dc4a3b5340678f84ea729239193aa559962cd8c1fce50

# --- Realm values the Part 1 documents state (preflight compares the realm file with these) ---
# 15 minutes: clinical workstations are shared.
REALM_SSO_IDLE_SECONDS=900
# 12 hours: covers a long shift.
REALM_SSO_MAX_SECONDS=43200
REALM_PASSWORD_HISTORY=5

# --- Local decisions -------------------------------------------------------------------
PUBLIC_HOSTS="iam.hospital.test apps.hospital.test iam-admin.hospital.test"
# Set 8443 if Phase 0 step 6 shows 443 cannot be bound.
HOST_HTTPS_PORT=443
# Set 8080 in that case.
HOST_HTTP_PORT=80
MIN_DOCKER_MEMORY_GB=6